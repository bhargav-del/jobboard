{
  "name": "jobboard",
  "version": "2.0.0",
  "description": "Self-contained Windows desktop job pipeline with search, drag-and-drop stages, and follow-up tracking.",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dist": "electron-builder --win portable",
    "check": "node --check app.js"
  },
  "devDependencies": {
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12",
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^7.4.0",
    "@capacitor/core": "^7.4.0"
  },
  "build": {
    "appId": "dev.yuin.jobboard",
    "productName": "Jobboard",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "desktop/**/*",
      "package.json",
      "manifest.webmanifest",
      "sw.js"
    ],
    "win": {
      "target": "portable",
      "artifactName": "Jobboard-Portable-${version}.exe"
    }
  }
}
